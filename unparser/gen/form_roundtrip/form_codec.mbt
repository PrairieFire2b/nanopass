// GENERATED by `@unparser/gen.gen_source` for FormBase, checked in so the
// custom surface forms (`#nano.form`, `#nano.inline`) can be compiled and
// executed by the roundtrip tests. (The `_ => unreachable tree ext` arm the
// generator emits is dropped here because this group has no ext constructors.)

///|
pub fn FExpr::from_sexp(sexp : @sexp.Sexp) -> FExpr raise @sexp.SexpError {
  match @sexp.match_form(sexp, "(lambda $0 $1)", 2, path="FExpr.Lam") {
    Some(fields) =>
      return FExpr(
        Tree::Lam(
          @sexp.string_from_atom(fields[0], path="FExpr.Lam[0]"),
          FExpr::from_sexp(fields[1]),
        ),
      )
    None => ()
  }
  match @sexp.match_form(sexp, "($0 $1)", 2, path="FExpr.App") {
    Some(fields) =>
      return FExpr(
        Tree::App(FExpr::from_sexp(fields[0]), FExpr::from_sexp(fields[1])),
      )
    None => ()
  }
  match @sexp.atom_text(sexp) {
    Some(atom) => {
      try {
        let v = @sexp.int_from_atom(sexp, path="FExpr.Num")
        return FExpr(Tree::Num(v))
      } catch {
        _ => ()
      }
      try {
        let v = @sexp.string_from_atom(sexp, path="FExpr.Var")
        return FExpr(Tree::Var(v))
      } catch {
        _ => ()
      }
      @sexp.decode_error(
        path="FExpr",
        message="no atom constructor matched: " + atom,
      )
    }
    None => {
      let items = @sexp.expect_list(sexp, path="FExpr")
      guard items.length() > 0 else {
        @sexp.decode_error(path="FExpr", message="empty list")
      }
      let head = @sexp.expect_atom(items[0], path="FExpr.head")
      match head {
        "Lam" => {
          @sexp.expect_arity(items, 3, path="FExpr.Lam")
          FExpr(
            Tree::Lam(
              @sexp.string_from_atom(items[1], path="FExpr.Lam[0]"),
              FExpr::from_sexp(items[2]),
            ),
          )
        }
        "App" => {
          @sexp.expect_arity(items, 3, path="FExpr.App")
          FExpr(
            Tree::App(FExpr::from_sexp(items[1]), FExpr::from_sexp(items[2])),
          )
        }
        _ => @sexp.unknown_head(head, path="FExpr")
      }
    }
  }
}

///|
pub fn FExpr::to_sexp_doc(self : FExpr) -> @sexp.SexpDoc raise @sexp.SexpError {
  match self {
    FExpr(Tree::Num(x0)) => @sexp.int_to_doc(x0)
    FExpr(Tree::Var(x0)) => @sexp.string_to_doc(x0)
    FExpr(Tree::Lam(x0, x1)) =>
      @sexp.form_doc(
        "(lambda $0 $1)",
        [@sexp.string_to_doc(x0), x1.to_sexp_doc()],
        path="FExpr.Lam",
      )
    FExpr(Tree::App(x0, x1)) =>
      @sexp.form_doc(
        "($0 $1)",
        [x0.to_sexp_doc(), x1.to_sexp_doc()],
        path="FExpr.App",
      )
  }
}

///|
pub fn FExpr::parse_sexp(input : StringView) -> FExpr raise @sexp.SexpError {
  FExpr::from_sexp(@sexp.parse(input))
}

///|
pub fn FExpr::unparse_sexp(
  self : FExpr,
  width? : Int,
) -> String raise @sexp.SexpError {
  @sexp.render(FExpr::to_sexp_doc(self), width?)
}
